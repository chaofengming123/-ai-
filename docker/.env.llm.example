# 将下面配置追加到本地 docker/.env；不要覆盖现有数据库、JWT、MinIO 配置。
# 此文件不含密钥，真实 API Key 只能写进被忽略的 docker/.env。
# 完整 Chat Completions URL，需要包含 /chat/completions。
LLM_ENDPOINT='https://api.deepseek.com/chat/completions'
LLM_API_KEY=''
LLM_MODEL='deepseek-flash'
# 按服务商文档选择 max_tokens 或 max_completion_tokens。
LLM_TOKEN_PARAMETER='max_tokens'
# 本课使用普通文本回答，关闭 DeepSeek 思考模式。
LLM_THINKING='disabled'
