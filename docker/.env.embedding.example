# 将以下三行补充到本地 docker/.env，保留已有数据库与 GLM 配置。
# API Key 只在本机填写，不要提交到 Git。
EMBEDDING_ENDPOINT='https://api.siliconflow.cn/v1/embeddings'
EMBEDDING_MODEL='BAAI/bge-m3'
EMBEDDING_API_KEY=''
# BAAI/bge-m3 当前免费；不要误填收费的 Pro/BAAI/bge-m3。
# 以后可修改完整 HTTPS 地址、模型和密钥，接入同一请求/响应格式的收费服务。
# 不自动换模型、换服务商或重试；与 GLM 的 LLM_* 配置独立。
